# Auto-detect text files and normalise line endings to LF in the repo
* text=auto

# Shell scripts must always use LF, even on Windows
*.sh text eol=lf

# Batch files must always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Frozen static snapshot of the previous site: keep bytes exactly as built.
public/original/** -text
